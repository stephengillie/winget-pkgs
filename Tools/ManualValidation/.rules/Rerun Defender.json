{
  "RuleName": "Rerun Defender",
  "Schedule": "Hourly",
  "Conditions": [
    {
      "Key": "Labels",
      "Comparison": "Match",
      "Value": "Validation-Defender-Error"
    },
    {
      "Key": "HoursSinceLastPipelineRun",
      "Comparison": "GreaterThan",
      "Value": "8"
    }
  ],
  "Actions": [
    {
      "Action": "ReplyToPR",
      "Data": "@wingetbot run"
    }
  ]
}
