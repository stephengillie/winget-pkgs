{
  "RuleName": "Auth JRSoftware.InnoSetup.7 ",
  "Schedule": "Hourly",
  "Conditions": [
    {
      "Key": "PackageIdentifier",
      "Comparison": "Equals",
      "Value": "JRSoftware.InnoSetup.7"
      },
      {
      "Key": "Labels",
      "Comparison": "NotMatch",
      "Value": "Needs-Review"
    },
    {
      "Key": "Author",
      "Comparison": "NotEquals",
      "Value": "martijnlaan"
    },
    {
      "Key": "Author",
      "Comparison": "NotEquals",
      "Value": "jordanrussell"
    }
  ],
  "Actions": [
    {
      "Action": "ReplyToPR",
      "Data": "Hi @martijnlaan, @jordanrussell`n`nDo you approve of these changes?"
      },
      {
      "Action": "AddLabel",
      "Data": "Needs-Review"
    }
  ]
}
