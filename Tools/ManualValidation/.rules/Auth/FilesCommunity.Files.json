{
  "RuleName": "Auth FilesCommunity.Files ",
  "Schedule": "Hourly",
  "Conditions": [
    {
      "Key": "PackageIdentifier",
      "Comparison": "Equals",
      "Value": "FilesCommunity.Files"
      },
      {
      "Key": "Labels",
      "Comparison": "NotMatch",
      "Value": "Needs-Review"
    },
    {
      "Key": "Author",
      "Comparison": "NotEquals",
      "Value": "yair100"
    },
    {
      "Key": "Author",
      "Comparison": "NotEquals",
      "Value": "Josh65-2201"
    }
  ],
  "Actions": [
    {
      "Action": "ReplyToPR",
      "Data": "Hi @yair100, @Josh65-2201`n`nDo you approve of these changes?"
      },
      {
      "Action": "AddLabel",
      "Data": "Needs-Review"
    }
  ]
}
