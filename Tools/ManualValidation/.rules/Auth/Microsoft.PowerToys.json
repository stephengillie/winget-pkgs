{
  "RuleName": "Auth Microsoft.PowerToys ",
  "Schedule": "Hourly",
  "Conditions": [
    {
      "Key": "PackageIdentifier",
      "Comparison": "Equals",
      "Value": "Microsoft.PowerToys"
      },
      {
      "Key": "Labels",
      "Comparison": "NotMatch",
      "Value": "Needs-Review"
    },
    {
      "Key": "Author",
      "Comparison": "NotEquals",
      "Value": "crutkas"
    },
    {
      "Key": "Author",
      "Comparison": "NotEquals",
      "Value": "consvc"
    },
    {
      "Key": "Author",
      "Comparison": "NotEquals",
      "Value": "yeelam-gordon"
    }
  ],
  "Actions": [
    {
      "Action": "ReplyToPR",
      "Data": "Hi @crutkas, @consvc, @yeelam-gordon`n`nDo you approve of these changes?"
      },
      {
      "Action": "AddLabel",
      "Data": "Needs-Review"
    }
  ]
}
