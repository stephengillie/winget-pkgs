{
  "RuleName": "Autowaiver BlueBubbles.BlueBubbles ",
  "Schedule": "Hourly",
  "Conditions": [
    {
      "Key": "PackageIdentifier",
      "Comparison": "Equals",
      "Value": "BlueBubbles.BlueBubbles"
    },
    {
      "Key": "Labels",
      "Comparison": "Match",
      "Value": "Validation-Installation-Error"
    }
  ],
  "Actions": [
    {
      "Action": "ReplyToPR",
      "Data": "@wingetbot waivers Add Validation-Installation-Error"
    }
  ]
}
