{
  "RuleName": "Agreements IDRIX.VeraCrypt",
  "Schedule": "Hourly",
  "Conditions": [
    {
      "Key": "PackageIdentifier",
      "Comparison": "Equals",
      "Value": "IDRIX.VeraCrypt"
    },
    {
      "Key": "AgreementUrl",
      "Comparison": "NotEquals",
      "Value": "https://veracrypt.io/en/VeraCrypt%20License.html"
      },
      {
      "Key": "Labels",
      "Comparison": "NotMatch",
      "Value": "Needs-Author-Feedback"
    }
  ],
  "Actions": [
    {
      "Action": "ReplyToPR",
      "Data":  "Hi @`n`nThis package uses Agreements, but this manifest's AgreementsUrl doesn't match the AgreementsUrl on file: https://veracrypt.io/en/VeraCrypt%20License.html"
      },
      {
      "Action": "AddLabel",
      "Data": "Needs-Author-Feedback"
    }
  ]
}
